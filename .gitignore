# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.env

!.env.example
!.env.*.example

# --- Dependencies & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Build Outputs & Bundles ---
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# --- Python & Virtual Environments (Jika ada script backend/Rasa) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
