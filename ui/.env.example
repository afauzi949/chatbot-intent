# ===================================================
# Chatbot Web Interface — Example Environment Variables
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
# ===================================================

# LLM Provider ('Custom', 'Google', 'Anthropic', 'OpenAI')
VITE_LLM_PROVIDER=Custom

# LLM Base URL (e.g., https://api.openai.com/v1, https://ai.sumopod.com/v1)
VITE_LLM_BASE_URL=https://api.example.com/v1

# LLM API Key
VITE_LLM_API_KEY=your_llm_api_key_here

# Default Model ID (e.g., gemini-3.7-flash, claude-sonnet-4.6, gpt-4o)
VITE_DEFAULT_MODEL=gemini-3.7-flash

# Rasa Server Endpoint
# Used for Intent Classification and Dialog Management
VITE_RASA_URL=http://localhost:5005

# MCP (Model Context Protocol) Server / Tools Endpoint
VITE_MCP_URL=http://localhost:8000
